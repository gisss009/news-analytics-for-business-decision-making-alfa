# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Режим LLM: stub (по умолчанию, без сети и ключа, демо и тесты) или real (HTTP к общему ключу)
LLM_MODE=stub
# OpenAI-совместимый эндпоинт общего ключа кейса
LLM_BASE_URL=https://example.invalid/v1
# Ключ LLM. Никогда не коммитить реальное значение
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# Дневной бюджет на общий ключ, руб.; предупреждение при доле BUDGET_WARN_RATIO
DAILY_BUDGET_RUB=500
BUDGET_WARN_RATIO=0.8

# Каталог данных и файл SQLite (по умолчанию data/ и data/runtime/app.sqlite в корне репозитория)
# DATA_DIR=data
# DB_PATH=data/runtime/app.sqlite

# Максимум итераций исправления в цикле Interpreter → Verifier
MAX_VERIFY_ITERATIONS=2
LOG_LEVEL=INFO

# Папки Google Drive с данными кейса (для scripts/fetch_data.py), ссылки из кейса
DATASET_FOLDER_URL=
ANALYTICS_FOLDER_URL=
